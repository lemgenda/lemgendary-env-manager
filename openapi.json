{
  "openapi": "3.1.0",
  "info": {
    "title": "LemGendary Environment Manager API",
    "description": "REST and WebSocket sidecar service for LemGendary AI Studio.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "description": "Retrieve complete ecosystem health audit.",
        "operationId": "get_health_api_health_get",
        "parameters": [
          {
            "name": "include_safety",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, run per-project pip dry-runs to classify which outdated packages can be safely upgraded. Adds 15-40s of latency per Python project. Default false for fast polling.",
              "default": false,
              "title": "Include Safety"
            },
            "description": "If true, run per-project pip dry-runs to classify which outdated packages can be safely upgraded. Adds 15-40s of latency per Python project. Default false for fast polling."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/drift": {
      "get": {
        "summary": "Get Drift",
        "description": "Retrieve Python and NPM package drift data, manifest coverage, and\nsingle-manifest inventory.\n\nReturns:\n\n- ``python``: cross-project drift entries (packages in >= 2 manifests).\n- ``coverage``: per-project declared-vs-installed reconciliation.\n- ``single_manifest``: packages declared in exactly one manifest.\n- ``npm``: npm workspace drift entries.",
        "operationId": "get_drift_api_drift_get",
        "parameters": [
          {
            "name": "include_safety",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Same semantics as /api/health?include_safety.",
              "default": false,
              "title": "Include Safety"
            },
            "description": "Same semantics as /api/health?include_safety."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
