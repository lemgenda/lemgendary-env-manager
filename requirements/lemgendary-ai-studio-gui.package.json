{
  "name": "lemgendary-ai-studio-gui",
  "private": true,
  "version": "2.10.76",
  "type": "module",
  "scripts": {
    "sync:ecosystem": "node scripts/sync-ecosystem.mjs",
    "check:ecosystem": "node scripts/sync-ecosystem.mjs --check",
    "predev": "npm run sync:ecosystem",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "prebuild": "npm run sync:ecosystem",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "verify": "node -e \"const p=require('path');const w=process.platform==='win32';const exe=p.join('..','lemgendary-env-manager','.venv',w?'Scripts':'bin',w?'lem-env.exe':'lem-env');const r=require('child_process').spawnSync(exe,['validate','--project','lemgendary-ai-studio-gui'],{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.2.1",
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "modern-screenshot": "4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "~2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
