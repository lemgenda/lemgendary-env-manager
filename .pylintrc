[MASTER]
ignore=CVS
persistent=yes
load-plugins=
jobs=1
unsafe-load-any-extension=no

[MESSAGES CONTROL]
disable=
    too-many-branches,
    too-many-locals,
    too-many-statements,
    too-many-lines,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-nested-blocks,
    missing-docstring

[REPORTS]
output-format=text
reports=no
score=yes
