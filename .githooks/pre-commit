#!/bin/bash
# Pre-commit hook to block commits with warnings or errors.
# Project standards enforce 100% compliance with syntax, type safety, and linting.

# Ensure we use the virtual environment's python
if [ -f "./.venv/Scripts/python.exe" ]; then
    VENV_PYTHON="./.venv/Scripts/python.exe"
else
    VENV_PYTHON="c:/Development/python/model-training/lemgendary-env-manager/.venv/Scripts/python.exe"
fi

# Get a list of staged Python files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Running pre-commit checks on staged Python files..."
HAS_ERRORS=0

# 1. Syntax Check (python -m py_compile)
for FILE in $STAGED_FILES; do
    echo "Checking syntax: $FILE"
    if ! "$VENV_PYTHON" -m py_compile "$FILE"; then
        echo "[FATAL] Syntax error in $FILE"
        HAS_ERRORS=1
    fi
done

# 2. Pylint (Linting)
echo "Running pylint..."
if ! "$VENV_PYTHON" -m pylint $STAGED_FILES; then
    echo "[WARNING/ERROR] Pylint found issues."
    HAS_ERRORS=1
fi

# 3. Pyright (Type Checking)
echo "Running pyright..."
if ! "$VENV_PYTHON" -m pyright $STAGED_FILES; then
    echo "[WARNING/ERROR] Pyright found issues."
    HAS_ERRORS=1
fi

# 4. Environment Manager Audit Suite
echo "Running environment manager verification..."
if ! "$VENV_PYTHON" verify_env_manager.py --staged; then
    echo "[WARNING/ERROR] Environment manager verification failed."
    HAS_ERRORS=1
fi


if [ $HAS_ERRORS -ne 0 ]; then
    echo "====================================================="
    echo "COMMIT BLOCKED"
    echo "Please fix all errors and warnings above before committing."
    echo "All code must be completely clean."
    echo "====================================================="
    exit 1
fi

echo "[SUCCESS] All checks passed! Proceeding with commit."
exit 0
